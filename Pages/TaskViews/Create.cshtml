@page
@using Replay.Model
@model Replay.Pages.TaskViews.TaskCreateModel

@{
ViewData["Title"] = "Create";
}
<html>

<head>
    <link rel="stylesheet" href="\css\TaskStylesheet.css">
</head>

<body style="overflow-x: hidden;">
<div class="frame-1" style="left: 15px;position: relative;">
    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="taskId" data-taskid="@Model.DisplayTask.Id" value="@Model.DisplayTask.Id"/>
        <div >
            <header class="header">
                <h1 class="headertext">Neue Aufgabe erstellen</h1>
            </header>
            <div class="wrapper">
                <div class="title">Titel:</div>
                <div class="input-field">
                    <div class="label">
                        <input type="text" name="taskNameInput" value="@Model.DisplayTask.TaskName" placeholder="Bitte Aufgabennamen eingeben" required="" class="textinput">
                    </div>
                </div>
                <div class="title">Zuständig:</div>
                <select class="dropdown" name="responsible" required="">
                    <optgroup label="Benutzer" name="responsibleUser" >
                        @foreach (User user in @Model.AllUser)
                        {
                            <option class="dropdown-element" name="responsibleUser">@user.Name</option>
                        }
                    </optgroup>
                    <optgroup label="Rolle" name="responsibleRole">
                        @foreach (Role role in @Model.AllRoles)
                        {
                            <option class="dropdown-element" name="responsibleRole">@role.RoleName</option>
                        }
                    </optgroup>
                </select>
                <div class="title">Fällig am:</div>
                <div class="input-field">
                    <div class="label">
                        @*<input required="" name="dueDateInput" type="date" min="2024-01-01" class="selectdate" data-val="true" value="@Model.DisplayTask.DueDate.ToString("yyyy-MM-dd")">*@
                    </div>
                </div>
                <div class="title">Fortschritt:</div>
                <select class="dropdown" name="taskStatus">
                    @foreach(Status status in @Model.AllStatus)
                    {
                        @if (string.Equals(Model.DisplayTask.TaskStatus.ToString(), status.ToString()))
                        {
                            <option class="dropdown-element" selected value="@status">
                                @TranslationStatus.getTranslation(status)
                            </option>
                        } else
                        {
                            <option class="dropdown-element" value="@status">
                                @TranslationStatus.getTranslation(status)
                            </option>
                        }
                    }
                </select>

                <div class="title">Anleitung:</div>
                <textarea type="text" name="instructions" placeholder="Optionale Anleitung eingeben" class="input-field textinputXL" id="area" ></textarea>
                <div class="title"></div>
                <div style="display:none;" class="input-field textinputXL" id="output"></div>
            </div>
            <div class="buttonarea">
                <div class="primary button">
                    <input type="submit" class="buttonlabel label" value="Erstellen">
                </div>
            </div>
        </div>
    </form>

</div>
<script src="https://cdn.jsdelivr.net/npm/markdown-it/dist/markdown-it.min.js"></script>
<script>
    // initialize markdown-it library
    var md = window.markdownit();
    var editor = document.getElementById('area');
    var output = document.getElementById('output');
    var custom = document.getElementById('custom');
    var div = document.getElementById('costumdiv');
    var dueDate = document.getElementById('duedate');

    editor.addEventListener('input', function() {
        // parse the Markdown into HTML
        var html = md.render(editor.value);
        // output the HTML
        output.innerHTML = html;
        output.style.display = "block";
    });
    dueDate.addEventListener('change',function () {
        console.log(dueDate.options[dueDate.selectedIndex].value);
        console.log(div.getAttribute('data-value'));
        if (dueDate.options[dueDate.selectedIndex].value === div.getAttribute('data-value')) {
            custom.style.display = "block";
            div.style.display = "block";
        } else {
            custom.style.display = "none";
            div.style.display = "none";
        }

    });
    
    window.onload = function load() {
        div.style.display = "none";
        custom.style.display = "none";
        var html = md.render(editor.value);
        output.innerHTML = html;
    }
</script>



</body>
</html>


