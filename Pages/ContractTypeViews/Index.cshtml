@page
@model Replay.Pages.ContractTypesViews.IndexModel

@{
    ViewData["Title"] = "ContractTypesIndex";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ContractType) {
    <tr>
        <td>
            @item.ContractName
        </td>
        <td>
            <a asp-page="./Edit" asp-route-id="@item.ContractName">Edit</a> |
            <a asp-page="./Details" asp-route-id="@item.ContractName">Details</a> |
            <a asp-page="./Delete" asp-route-id="@item.ContractName">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
